{
  "buildCommand": "node scripts/move-any-destination.cjs && node scripts/upgrade-date-range.cjs && node scripts/harden-email-monitor.cjs && node scripts/store-all-flight-suggestions.cjs && node scripts/enable-manual-refresh.cjs && node scripts/add-home-promotions.cjs",
  "outputDirectory": ".",
  "functions": {
    "api/flights.js": { "maxDuration": 30 },
    "api/flight-booking.js": { "maxDuration": 30 },
    "api/monitor-trips.js": { "maxDuration": 60 },
    "api/managed-trips.js": { "maxDuration": 30 },
    "api/available-dates.js": { "maxDuration": 30 },
    "api/email-health.js": { "maxDuration": 30 },
    "api/latest-promotions.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ]
}
